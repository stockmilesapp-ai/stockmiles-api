# Postgres connection string. Must start with postgresql+asyncpg:// and have
# special characters in the password percent-encoded.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:6543/postgres

# Google sign-in. The client ID is public; it ends in .apps.googleusercontent.com
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
# Secret. Not used by the ID-token flow; needed only for the redirect (callback) flow.
GOOGLE_CLIENT_SECRET=
